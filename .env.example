# Application Settings
APP_NAME=AI Career Autopilot
APP_VERSION=1.0.0
DEBUG=False

# MongoDB Configuration
MONGODB_URL=mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=ai_career_autopilot

# JWT Authentication
JWT_SECRET_KEY=your-super-secret-jwt-key-change-this-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# JSearch API (RapidAPI)
JSEARCH_API_KEY=your_jsearch_api_key_here
JSEARCH_API_URL=https://jsearch.p.rapidapi.com

# Adzuna API
ADZUNA_APP_ID=your_adzuna_app_id
ADZUNA_APP_KEY=your_adzuna_app_key
ADZUNA_BASE_URL=https://api.adzuna.com/v1/api
ADZUNA_COUNTRY=us

# Coursera API
COURSERA_API_URL=https://api.coursera.org/api/courses.v1

# Groq API
GROQ_API_KEY=your_groq_api_key_here
GROQ_API_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile

# HuggingFace (Optional)
HUGGINGFACE_TOKEN=your_huggingface_token_here

# DeepSeek API (Optional)
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_API_URL=https://api.deepseek.com/v1

# Frontend URL (for CORS - set to your Render frontend URL)
FRONTEND_URL=http://localhost:3000

# Scheduler
SCHEDULER_ENABLED=True
WEEKLY_UPDATE_CRON=0 9 * * 1
